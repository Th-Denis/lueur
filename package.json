{
  "name": "lueur",
  "private": true,
  "description": "Calendrier de photos programmées, chiffrées de bout en bout.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.23.0 <13"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:start && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && pnpm run test:hooks && pnpm run test:db-scripts",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint && pnpm run lint:hooks && pnpm run lint:db-scripts",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:hooks": "vitest run --config .claude/hooks/vitest.config.mjs",
    "lint:hooks": "eslint --max-warnings=0 .claude/hooks",
    "test:db-scripts": "vitest run --config supabase/scripts/vitest.config.mjs",
    "lint:db-scripts": "eslint --max-warnings=0 supabase/scripts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --schema public,private,audit --level warning --fail-on warning",
    "db:check-rollbacks": "node supabase/scripts/check-rollbacks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
