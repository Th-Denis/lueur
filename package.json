{
  "name": "lueur",
  "private": true,
  "description": "Calendrier de photos programmées, chiffrées de bout en bout.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.23.0 <13"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && pnpm run test:hooks",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint && pnpm run lint:hooks",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:hooks": "vitest run --config .claude/hooks/vitest.config.mjs",
    "lint:hooks": "eslint --max-warnings=0 .claude/hooks"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
